# Environment Configuration for Prior Authorization Assistant
# Backend Port
PORT=5001

# Database Configuration (SQLite default for zero-config local run, or PostgreSQL)
# Example for SQLite: file:./dev.db
# Example for PostgreSQL: postgresql://username:password@localhost:5432/prior_auth_db
DATABASE_URL="file:./dev.db"

# Session & JWT Security Key
JWT_SECRET="prior-auth-jwt-secret-key-production-ready-2026"

# Frontend Origin for CORS & Cookies
FRONTEND_URL="http://localhost:5173"

# File Upload Storage Directory
UPLOAD_DIR="./uploads"

# Optional AI API Key for live LLM extraction (Leave empty to use high-fidelity Deterministic Clinical NLP Demo Mode)
AI_API_KEY=""
AI_MODEL="gemini-1.5-pro"

# Environment
NODE_ENV="development"
