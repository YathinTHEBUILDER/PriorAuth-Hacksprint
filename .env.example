# Environment Configuration for Prior Authorization Assistant
# Backend Port
PORT=5001

# Supabase Postgres connection string (Project Settings > Database > Connection string)
# Use the direct connection for Prisma migrations and server runtime.
DATABASE_URL="postgresql://postgres:<DATABASE_PASSWORD>@db.sqdkkrmfoggshmaktwhr.supabase.co:5432/postgres?sslmode=require"

# Private Supabase Storage for source documents (server-side only)
SUPABASE_URL="https://sqdkkrmfoggshmaktwhr.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-the-project-service-role-key"

# Session & JWT Security Key
JWT_SECRET="replace-with-a-long-random-secret"

# Frontend Origin for CORS & Cookies
FRONTEND_URL="http://localhost:5173"

# File Upload Storage Directory
UPLOAD_DIR="./uploads"

# Optional AI API Key for live LLM extraction (Leave empty to use high-fidelity Deterministic Clinical NLP Demo Mode)
AI_API_KEY=""
AI_MODEL="gemini-1.5-pro"

# Environment
NODE_ENV="development"
